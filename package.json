{
	"name": "eslint-config-expo-magic-monorepo",
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.0.0"
	},
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"test": "bun test packages/eslint-config-expo-magic scripts/lib/config-report.test.js scripts/lib/release-notes.test.js test-project/validation-results.test.js",
		"typecheck": "cd packages/eslint-config-expo-magic && bun run typecheck",
		"audit:deps": "bun scripts/audit-dependencies.js",
		"check-pm": "node packages/eslint-config-expo-magic/check-pm.js",
		"ci": "bun install --frozen-lockfile",
		"validate": "cd test-project && bun run validate",
		"smoke:pack": "bun scripts/smoke-packed-consumer.js",
		"smoke:contracts": "bun scripts/smoke-packed-consumer.js --contracts-only",
		"smoke:npm-consumer": "bun scripts/smoke-packed-consumer.js --npm-only",
		"smoke:clean-sdk57": "bun scripts/smoke-clean-sdk57-consumer.js",
		"smoke:release": "bun scripts/smoke-packed-consumer.js",
		"report:config": "node scripts/generate-config-report.js",
		"report:release-notes": "node scripts/generate-release-notes.js",
		"release:check": "node scripts/release-check.js",
		"cleanup:npm": "rimraf node_modules packages/**/node_modules test-project/node_modules",
		"publish-package": "bun scripts/publish-package.js"
	},
	"workspaces": [
		"packages/eslint-config-expo-magic",
		"test-project"
	],
	"devDependencies": {
		"@types/react": "~19.2.17",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"bun-types": "^1.3.14",
		"eslint": "^10.8.0",
		"eslint-config-expo": "^57.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-boundaries": "^7.1.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.16.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-19-upgrade": "^1.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-native": "^5.0.0",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.8.0",
		"jest": "^30.4.2",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	},
	"overrides": {
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@typescript-eslint/utils": "^8.65.0"
	}
}
