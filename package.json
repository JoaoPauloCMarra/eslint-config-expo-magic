{
	"name": "eslint-config-expo-magic-monorepo",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24",
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.3",
	"private": true,
	"scripts": {
		"test": "bun test packages/eslint-config-expo-magic scripts/lib",
		"typecheck": "tsc -p packages/eslint-config-expo-magic/tsconfig.types.json",
		"ci": "bun install --frozen-lockfile",
		"golden:bun": "bun scripts/bun-golden.js --fixes",
		"smoke:bun-consumer": "bun scripts/smoke-bun-consumer.js",
		"release:check": "bun scripts/release-check.js",
		"cleanup:npm": "rimraf node_modules packages/**/node_modules test-project/node_modules",
		"publish-package": "bun scripts/publish-package.js"
	},
	"workspaces": [
		"packages/eslint-config-expo-magic",
		"test-project"
	],
	"devDependencies": {
		"@types/react": "~19.2.18",
		"@typescript-eslint/parser": "^8.71.0",
		"bun-types": "^1.4.3",
		"eslint": "^10.11.0",
		"eslint-config-expo": "^57.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-boundaries": "^7.2.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react-19-upgrade": "^1.11.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-native": "^5.0.0",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.12.0",
		"jest": "^30.5.2",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"overrides": {
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"@typescript-eslint/utils": "^8.71.0"
	}
}
