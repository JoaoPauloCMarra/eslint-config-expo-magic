{
	"name": "eslint-config-expo-magic-bun-next",
	"version": "6.0.0-next.0",
	"private": true,
	"description": "Bun lint and bun fmt config for Expo, React Native, and TypeScript projects",
	"keywords": [
		"bun",
		"bun-lint",
		"bun-fmt",
		"oxlint",
		"lint",
		"format",
		"react",
		"react-native",
		"expo",
		"typescript",
		"jest",
		"testing-library",
		"mobile"
	],
	"homepage": "https://github.com/JoaoPauloCMarra/eslint-config-expo-magic#readme",
	"bugs": {
		"url": "https://github.com/JoaoPauloCMarra/eslint-config-expo-magic/issues"
	},
	"license": "MIT",
	"author": {
		"name": "João Paulo Costa Marra",
		"email": "joaopaulocmarra@gmail.com",
		"url": "https://github.com/JoaoPauloCMarra/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoaoPauloCMarra/eslint-config-expo-magic.git"
	},
	"type": "commonjs",
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./base": {
			"types": "./base.d.ts",
			"default": "./base.js"
		},
		"./fast": {
			"types": "./fast.d.ts",
			"default": "./fast.js"
		},
		"./strict": {
			"types": "./strict.d.ts",
			"default": "./strict.js"
		},
		"./typed": {
			"types": "./typed.d.ts",
			"default": "./typed.js"
		},
		"./agent": {
			"types": "./agent.d.ts",
			"default": "./agent.js"
		},
		"./mobile-app": {
			"types": "./mobile-app.d.ts",
			"default": "./mobile-app.js"
		},
		"./architecture": {
			"types": "./architecture.d.ts",
			"default": "./architecture.js"
		},
		"./prettier": {
			"types": "./prettier.d.ts",
			"default": "./prettier.js"
		},
		"./pr-guardrails": {
			"types": "./pr-guardrails.d.ts",
			"default": "./pr-guardrails.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"expo-magic-init": "bin/init.js",
		"expo-magic-pr-guardrails": "bin/pr-guardrails.js"
	},
	"sideEffects": false,
	"files": [
		"*.js",
		"*.d.ts",
		".prettierrc.js",
		"README.md",
		"bin/*.js",
		"rules/**/*.js",
		"utils/*.js",
		"utils/*.json",
		"!**/*.test.js"
	],
	"peerDependencies": {
		"expo": "^54.0.33 || ^55.0.0 || ^56.0.0 || ^57.0.0",
		"react": "^19.1.0 || ^19.2.0"
	},
	"peerDependenciesMeta": {
		"expo": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.4.4"
	}
}
